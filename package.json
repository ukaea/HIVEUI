{
	"name": "hiveui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "node scripts/ensure-data-dir.js && npm run db:migrate",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.js",
		"db:push": "drizzle-kit push",
		"test": "npm run test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --plugin-search-dir . --write .",
		"test:integration": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"@types/pg": "8.20.0",
		"autoprefixer": "10.5.0",
		"drizzle-kit": "0.31.11",
		"playwright": "1.60.0",
		"postcss": "8.5.29",
		"postcss-load-config": "5.1.0",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "4.2.20",
		"svelte-check": "3.8.6",
		"svelte-ux": "1.0.11",
		"tailwindcss": "3.4.19",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "5.4.21"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@sveltejs/adapter-node": "^5.2.0",
		"arctic": "^3.7.0",
		"dotenv": "^16.4.5",
		"drizzle-orm": "^0.45.2",
		"jwt-decode": "^4.0.0",
		"nanostores": "^1.1.0",
		"node-jq": "^6.3.1",
		"pg": "^8.21.0",
		"uuid": "^10.0.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.21.5": true,
		"esbuild@0.28.2": true,
		"svelte-preprocess@6.0.3": true,
		"svelte-preprocess@5.1.4": true,
		"@parcel/watcher@2.5.6": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"node-jq@6.3.1": true
	},
	"overrides": {
		"cookie": "0.7.2",
		"svelte-ux": {
			"zod": "$zod"
		},
		"@layerstack/svelte-stores": {
			"zod": "$zod"
		},
		"node-jq": {
			"zod": "$zod"
		}
	}
}
